# Required: your Anthropic API key. It never leaves the server.
ANTHROPIC_API_KEY=sk-ant-...

# Required: who may use the server, as name:code pairs. Codes must be 16+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_CODES=me:replace-with-a-long-random-code

# Optional (defaults shown)
# PORT=8787
# ALLOWED_MODELS=claude-opus-5-5
# MAX_TOKENS=16000
# REQUESTS_PER_MINUTE=20
# REQUESTS_PER_DAY=500
