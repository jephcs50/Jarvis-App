{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jarvis.accountability"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jarvis.accountability"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#38D6FF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jarvis listens when you start a hands-free conversation.",
          "speechRecognitionPermission": "Jarvis turns what you say into text so it can reply.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withApkSigning"
    ],
    "scheme": "jarvis",
    "backgroundColor": "#070B12"
  }
}
